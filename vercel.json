{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self)"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/website/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/website/index.html"
    },
    {
      "source": "/styles/:path*",
      "destination": "/website/styles/:path*"
    },
    {
      "source": "/scripts/:path*",
      "destination": "/website/scripts/:path*"
    },
    {
      "source": "/downloads/:path*",
      "destination": "/website/downloads/:path*"
    }
  ]
}
